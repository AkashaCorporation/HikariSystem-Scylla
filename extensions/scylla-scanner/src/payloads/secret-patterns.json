{
  "patterns": [
    { "name": "AWS Access Key", "pattern": "AKIA[0-9A-Z]{16}", "severity": "critical", "category": "cloud" },
    { "name": "AWS Secret Key", "pattern": "(?:aws_secret_access_key|secret_key)\\s*[=:]\\s*['\"]?([A-Za-z0-9/+=]{40})", "severity": "critical", "category": "cloud" },
    { "name": "GitHub Token", "pattern": "gh[pousr]_[A-Za-z0-9_]{36,}", "severity": "high", "category": "vcs" },
    { "name": "GitHub OAuth", "pattern": "gho_[A-Za-z0-9]{36}", "severity": "high", "category": "vcs" },
    { "name": "GitLab Token", "pattern": "glpat-[A-Za-z0-9_-]{20,}", "severity": "high", "category": "vcs" },
    { "name": "Slack Token", "pattern": "xox[baprs]-[0-9a-zA-Z-]{10,}", "severity": "high", "category": "messaging" },
    { "name": "Slack Webhook", "pattern": "hooks\\.slack\\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[a-zA-Z0-9]+", "severity": "high", "category": "messaging" },
    { "name": "Discord Webhook", "pattern": "discord(?:app)?\\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+", "severity": "high", "category": "messaging" },
    { "name": "Stripe Secret Key", "pattern": "sk_live_[0-9a-zA-Z]{24,}", "severity": "critical", "category": "payment" },
    { "name": "Stripe Publishable Key", "pattern": "pk_live_[0-9a-zA-Z]{24,}", "severity": "medium", "category": "payment" },
    { "name": "Square Access Token", "pattern": "sq0atp-[0-9A-Za-z_-]{22}", "severity": "critical", "category": "payment" },
    { "name": "PayPal/Braintree Token", "pattern": "access_token\\$production\\$[0-9a-z]{16}\\$[0-9a-f]{32}", "severity": "critical", "category": "payment" },
    { "name": "JWT Token", "pattern": "eyJ[a-zA-Z0-9_-]+\\.eyJ[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+", "severity": "medium", "category": "auth" },
    { "name": "Bearer Token", "pattern": "(?:bearer|token)\\s+[a-zA-Z0-9_\\-\\.=]{20,}", "severity": "medium", "category": "auth" },
    { "name": "Basic Auth", "pattern": "(?:basic)\\s+[a-zA-Z0-9+/=]{20,}", "severity": "high", "category": "auth" },
    { "name": "Google API Key", "pattern": "AIza[0-9A-Za-z_-]{35}", "severity": "high", "category": "cloud" },
    { "name": "Google OAuth ID", "pattern": "[0-9]+-[0-9A-Za-z_]{32}\\.apps\\.googleusercontent\\.com", "severity": "medium", "category": "cloud" },
    { "name": "Firebase Key", "pattern": "AAAA[A-Za-z0-9_-]{7}:[A-Za-z0-9_-]{140}", "severity": "high", "category": "cloud" },
    { "name": "Twilio API Key", "pattern": "SK[a-f0-9]{32}", "severity": "high", "category": "messaging" },
    { "name": "SendGrid API Key", "pattern": "SG\\.[a-zA-Z0-9_-]{22}\\.[a-zA-Z0-9_-]{43}", "severity": "high", "category": "messaging" },
    { "name": "Mailgun API Key", "pattern": "key-[0-9a-zA-Z]{32}", "severity": "high", "category": "messaging" },
    { "name": "Heroku API Key", "pattern": "(?:heroku_api_key|HEROKU_API_KEY)\\s*[=:]\\s*['\"]?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", "severity": "high", "category": "cloud" },
    { "name": "DigitalOcean Token", "pattern": "dop_v1_[a-f0-9]{64}", "severity": "high", "category": "cloud" },
    { "name": "Azure Storage Key", "pattern": "DefaultEndpointsProtocol=https;AccountName=[^;]+;AccountKey=[A-Za-z0-9+/=]{88}", "severity": "critical", "category": "cloud" },
    { "name": "Private Key", "pattern": "-----BEGIN (?:RSA |DSA |EC )?PRIVATE KEY-----", "severity": "critical", "category": "crypto" },
    { "name": "SSH Private Key", "pattern": "-----BEGIN OPENSSH PRIVATE KEY-----", "severity": "critical", "category": "crypto" },
    { "name": "Database URL", "pattern": "(?:mysql|postgresql|mongodb|redis)://[^\\s'\"<>]+:[^\\s'\"<>]+@[^\\s'\"<>]+", "severity": "critical", "category": "database" },
    { "name": "Generic API Key", "pattern": "(?:api_key|apikey|api-key|api_secret)\\s*[=:]\\s*['\"]?([A-Za-z0-9_-]{16,})", "severity": "medium", "category": "generic" },
    { "name": "Generic Secret", "pattern": "(?:secret|password|passwd|pwd|token)\\s*[=:]\\s*['\"]([^'\"\\s]{8,})['\"]", "severity": "medium", "category": "generic" },
    { "name": "NPM Token", "pattern": "npm_[A-Za-z0-9]{36}", "severity": "high", "category": "vcs" },
    { "name": "PyPI Token", "pattern": "pypi-[A-Za-z0-9_-]{50,}", "severity": "high", "category": "vcs" },
    { "name": "Shopify Token", "pattern": "shpat_[a-fA-F0-9]{32}", "severity": "high", "category": "ecommerce" },
    { "name": "Algolia API Key", "pattern": "[a-f0-9]{32}", "severity": "low", "category": "generic", "contextRequired": true }
  ]
}
