{
  "name": "scylla-reporting",
  "displayName": "Scylla Reporting",
  "description": "Lifecycle-aware security assessment reporting for Scylla Studio.",
  "version": "0.2.0",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:scylla.reporting.generate",
    "onCommand:scylla.reporting.generateHeadless"
  ],
  "main": "./out/extensionV3.js",
  "contributes": {
    "commands": [
      {
        "command": "scylla.reporting.generate",
        "title": "Generate Security Assessment Report",
        "category": "Scylla Reporting"
      },
      {
        "command": "scylla.reporting.generateHeadless",
        "title": "Generate Security Assessment Report (Headless)",
        "category": "Scylla Reporting"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/vscode": "^1.104.0",
    "typescript": "^5.9.2"
  }
}
