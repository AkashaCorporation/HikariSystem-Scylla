	"tokenColors": [
		{
			"scope": [
				"comment"
			],
			"settings": {
				"foreground": "#786b6e",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.modifier",
				"storage.type"
			],
			"settings": {
				"foreground": "#ff0055",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#f1fa8c"
			}
		},
		{
			"name": "Function declarations",
			"scope": [
				"entity.name.function",
				"support.function",
				"support.constant.handlebars"
			],
			"settings": {
				"foreground": "#8be9fd"
			}
		},
		{
			"name": "Types declaration and references",
			"scope": [
				"support.class",
				"support.type",
				"entity.name.type",
				"entity.name.namespace",
				"entity.name.class"
			],
			"settings": {
				"foreground": "#ff9f1c"
			}
		},
		{
			"name": "Control flow keywords",
			"scope": [
				"keyword.control"
			],
			"settings": {
				"foreground": "#ff79c6",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Variable and parameter name",
			"scope": [
				"variable",
				"meta.definition.variable.name",
				"support.variable",
				"entity.name.variable"
			],
			"settings": {
				"foreground": "#f5f0f2"
			}
		},
		{
			"name": "Constants and enums",
			"scope": [
				"variable.other.constant",
				"variable.other.enummember"
			],
			"settings": {
				"foreground": "#bd93f9"
			}
		},
		{
			"name": "Numbers",
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#ffb86c"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"newOperator": "#ff79c6",
		"stringLiteral": "#f1fa8c",
		"customLiteral": "#8be9fd",
		"numberLiteral": "#ffb86c"
	}
}
