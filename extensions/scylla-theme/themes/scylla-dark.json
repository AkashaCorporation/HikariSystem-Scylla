	"tokenColors": [
		{
			"scope": [
				"comment"
			],
			"settings": {
				"foreground": "#6272a4",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.modifier",
				"storage.type"
			],
			"settings": {
				"foreground": "#00ff88",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#ffb86c"
			}
		},
		{
			"name": "Function declarations",
			"scope": [
				"entity.name.function",
				"support.function",
				"support.constant.handlebars"
			],
			"settings": {
				"foreground": "#f1fa8c"
			}
		},
		{
			"name": "Types declaration and references",
			"scope": [
				"support.class",
				"support.type",
				"entity.name.type",
				"entity.name.namespace",
				"entity.name.class"
			],
			"settings": {
				"foreground": "#8be9fd"
			}
		},
		{
			"name": "Control flow keywords",
			"scope": [
				"keyword.control"
			],
			"settings": {
				"foreground": "#ff79c6",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Variable and parameter name",
			"scope": [
				"variable",
				"meta.definition.variable.name",
				"support.variable",
				"entity.name.variable"
			],
			"settings": {
				"foreground": "#f8f8f2"
			}
		},
		{
			"name": "Constants and enums",
			"scope": [
				"variable.other.constant",
				"variable.other.enummember"
			],
			"settings": {
				"foreground": "#bd93f9"
			}
		},
		{
			"name": "Numbers",
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#bd93f9"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"newOperator": "#ff79c6",
		"stringLiteral": "#ffb86c",
		"customLiteral": "#f1fa8c",
		"numberLiteral": "#bd93f9"
	}
}
