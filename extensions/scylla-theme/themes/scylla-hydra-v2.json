	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#5e5458",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["comment.block.documentation", "comment.block.documentation punctuation"],
			"settings": {
				"foreground": "#6e6468",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["keyword", "storage.modifier", "storage.type"],
			"settings": {
				"foreground": "#e83860"
			}
		},
		{
			"scope": ["keyword.control"],
			"settings": {
				"foreground": "#c06bbd"
			}
		},
		{
			"scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.logical"],
			"settings": {
				"foreground": "#e83860"
			}
		},
		{
			"scope": ["string", "string.quoted"],
			"settings": {
				"foreground": "#d9a840"
			}
		},
		{
			"scope": ["string.template", "punctuation.definition.template-expression"],
			"settings": {
				"foreground": "#edc050"
			}
		},
		{
			"scope": ["string.regexp"],
			"settings": {
				"foreground": "#e88040"
			}
		},
		{
			"name": "Function declarations",
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#5a8fcc"
			}
		},
		{
			"name": "Method calls",
			"scope": ["meta.method-call entity.name.function"],
			"settings": {
				"foreground": "#6ea8e8"
			}
		},
		{
			"name": "Type declarations",
			"scope": ["support.class", "support.type", "entity.name.type", "entity.name.namespace", "entity.name.class"],
			"settings": {
				"foreground": "#4db8a4"
			}
		},
		{
			"name": "Interface and abstract types",
			"scope": ["entity.name.type.interface", "entity.name.type.alias"],
			"settings": {
				"foreground": "#66d0bc",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Variables",
			"scope": ["variable", "meta.definition.variable.name", "support.variable", "entity.name.variable"],
			"settings": {
				"foreground": "#d4cfd1"
			}
		},
		{
			"name": "Parameters",
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#e8c090",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Object properties",
			"scope": ["variable.other.property", "meta.object-literal.key"],
			"settings": {
				"foreground": "#b8a8ac"
			}
		},
		{
			"name": "Constants and enums",
			"scope": ["variable.other.constant", "variable.other.enummember"],
			"settings": {
				"foreground": "#c06bbd"
			}
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": {
				"foreground": "#e88040"
			}
		},
		{
			"name": "Boolean and null",
			"scope": ["constant.language"],
			"settings": {
				"foreground": "#e83860"
			}
		},
		{
			"name": "Escape characters",
			"scope": ["constant.character.escape"],
			"settings": {
				"foreground": "#e88040"
			}
		},
		{
			"name": "Decorators and annotations",
			"scope": ["meta.decorator", "meta.decorator entity.name.function"],
			"settings": {
				"foreground": "#d9a840",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Tag names",
			"scope": ["entity.name.tag", "meta.tag"],
			"settings": {
				"foreground": "#e83860"
			}
		},
		{
			"name": "Tag attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#4db8a4",
				"fontStyle": "italic"
			}
		},
		{
			"name": "CSS selectors",
			"scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
			"settings": {
				"foreground": "#d9a840"
			}
		},
		{
			"name": "CSS property names",
			"scope": ["support.type.property-name.css"],
			"settings": {
				"foreground": "#5a8fcc"
			}
		},
		{
			"name": "CSS values",
			"scope": ["support.constant.property-value.css", "support.constant.color.w3c-standard-color-name.css"],
			"settings": {
				"foreground": "#d4cfd1"
			}
		},
		{
			"name": "CSS units",
			"scope": ["keyword.other.unit.css"],
			"settings": {
				"foreground": "#e88040"
			}
		},
		{
			"name": "JSON keys",
			"scope": ["support.type.property-name.json"],
			"settings": {
				"foreground": "#5a8fcc"
			}
		},
		{
			"name": "JSON string values",
			"scope": ["meta.structure.dictionary.value.json string.quoted"],
			"settings": {
				"foreground": "#d9a840"
			}
		},
		{
			"name": "Markdown headings",
			"scope": ["markup.heading", "markup.heading entity.name"],
			"settings": {
				"foreground": "#e83860",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown bold",
			"scope": ["markup.bold"],
			"settings": {
				"foreground": "#ece8ea",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown italic",
			"scope": ["markup.italic"],
			"settings": {
				"foreground": "#c06bbd",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown links",
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#5a8fcc"
			}
		},
		{
			"name": "Markdown code",
			"scope": ["markup.inline.raw", "markup.fenced_code.block"],
			"settings": {
				"foreground": "#4db8a4"
			}
		},
		{
			"name": "Markdown list bullets",
			"scope": ["punctuation.definition.list.begin.markdown"],
			"settings": {
				"foreground": "#e83860"
			}
		},
		{
			"name": "Shell commands",
			"scope": ["source.shell", "source.powershell"],
			"settings": {
				"foreground": "#d4cfd1"
			}
		},
		{
			"name": "YAML keys",
			"scope": ["entity.name.tag.yaml"],
			"settings": {
				"foreground": "#5a8fcc"
			}
		},
		{
			"name": "INI/TOML section headers",
			"scope": ["entity.name.section", "keyword.other.definition.ini"],
			"settings": {
				"foreground": "#e83860",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation.separator", "punctuation.terminator"],
			"settings": {
				"foreground": "#8a7e82"
			}
		},
		{
			"name": "Brackets",
			"scope": ["punctuation.definition.block", "punctuation.definition.parameters", "meta.brace"],
			"settings": {
				"foreground": "#9a8e92"
			}
